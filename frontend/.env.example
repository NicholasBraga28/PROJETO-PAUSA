# Destino do proxy /api em dev (npm run dev / preview). Use a mesma porta do PORT em backend/.env.
API_PROXY_TARGET=http://localhost:3000
# Em produção, quando o frontend e a API não estão no mesmo endereço (ex.: https://api.exemplo.com/api).
# VITE_API_URL=
# Primeira duração tentada (minutos). A vigente é sempre descoberta na API; isto só evita tentativas.
# VITE_SESSION_MINUTES=20
# Intervalo técnico de consulta dos avisos do massoterapeuta (validar com produto).
# VITE_THERAPIST_NOTIFICATIONS_POLL_INTERVAL_MS=30000
