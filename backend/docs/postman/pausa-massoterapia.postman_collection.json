  "info": {
    "name": "Pausa Massoterapia - Backend",
    "description": "Smoke test da API. Pré-requisitos: Postgres no ar, migrations aplicadas e `npm run db:seed-demo` rodado.\n\nAutenticação (AUTH_MODE=header): cada pasta manda o header `x-user-id` com o id do usuário demo da sua role.\n\nRode as pastas na ordem (Runner) ou request por request. As variáveis `from`/`to` são recalculadas a cada request (agora → +7 dias).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = new Date();",
          "pm.collectionVariables.set('from', now.toISOString());",
          "pm.collectionVariables.set('to', new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000).toISOString());",
          "pm.collectionVariables.set('today', now.toISOString().slice(0, 10));"
        ]
      }
    }
  ],
